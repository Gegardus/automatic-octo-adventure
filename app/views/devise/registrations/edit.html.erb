<%= render_page_container do %>
  <%= render_page_header heading: 'Edit Profile' %>
  <%= render 'partials/form_errors', resource: resource %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render_grid do %>
      <%= f.text_field :first_name %>
      <%= f.text_field :last_name %>
      <%= f.text_field :phone %>
      <%= f.email_field :email, disabled: current_user.applicant? %>
      <%= f.date_field :date_of_birth, max: Date.today %>
      <%= f.password_field :current_password, required: true %>
    <% end %>

    <%= f.submit "Save", class: "btn-primary" %>
  <% end %>
<% end %>
