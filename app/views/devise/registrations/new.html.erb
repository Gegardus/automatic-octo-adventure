<%= render_centered_content heading: 'Sign up to our platform' do %>
  <%= render "devise/shared/links" %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: true } }) do |f| %>
    <div class="space-y-6">
 
      <%= f.text_field :first_name %>
      <%= f.text_field :last_name %>
      <%= f.text_field :phone %>
      <%= f.email_field :email %>
      <%= f.date_field :date_of_birth, max: Date.today %>

      <%= f.password_field :password %>
      <%= f.password_field :password_confirmation %>

      <%= show_simple_captcha %>

      <div class="flex items-center justify-between">
        <%= f.check_box :remember_me %>

        <div class="text-sm">
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium" %>
        </div>
      </div>
      <%= f.submit "Sign up", class: "btn-primary w-full" %>
    </div>
  <% end %>
<% end %>