<% content_for :steps_layout do %>
  <div class="container mx-auto gap-8 max-w-screen-xl">
    <div class="PageHeader flex flex-col sm:flex-row justify-between items-center sm:items-center pt-4 pb-4 sm:pt-0 sm:pb-0">
      <h1 class="text-xl sm:text-3xl font-extrabold text-gray-900 mb-4 sm:mb-6 sm:mt-6"><%= @steps.title %></h1>
      <div class="flex gap-2">
        <% if @steps.previous_step %>
          <%= link_to('Back', '#', class: "btn-secondary", onclick: "window.history.back();return false;") %>
        <% end %>
        <% if @current_step.skipped? || content_for?(:continue_button) && @current_step.completed? %>
          <%= yield :continue_button %>
        <% elsif content_for?(:always_show_continue_button) %>
          <%= yield :always_show_continue_button %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-gray-100 p-4 sm:p-10 sm:pt-0 pt-0">
    <div class="container max-w-screen-xl mt-6 mb-6">
      <%= render_steps(steps: @steps.all_steps, current_step: @current_step, step_links: @step_links) %>
    </div>
    <div class="bg-white steps-min-h-remaining rounded-lg">
      <%= yield %>
    </div>
  </div>

<% end %>

<%= render template: "layouts/application" %>
