<turbo-frame id="comments">
  <section class="bg-white dark:bg-gray-900 antialiased mt-6">
    <div class="mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-bold text-gray-900 dark:text-white">Conversation (<%= @comments.count %>)</h2>
      </div>

      <%= form_with(model: @comment, url: conversation_comment_path(@conversation), class: "mb-6", method: :patch) do |form| %>
        <div class="py-2 px-4 mb-4 bg-white rounded-lg rounded-t-lg dark:bg-gray-800 dark:border-gray-700">
          <%= form.text_area :message, rows: 6, class: "px-0 w-full text-sm text-gray-900 border-0 focus:ring-0 focus:outline-none dark:text-white dark:placeholder-gray-400 dark:bg-gray-800", placeholder: "Write a comment...", required: true %>
        </div>
        <%= form.submit "Post message", class: "btn-primary" %>
      <% end %>

      <% @comments.each_with_index do |comment, index| %>
        <article class="p-6 text-base bg-white rounded-lg dark:bg-gray-900 <%= 'border-b' unless index == @comments.length - 1 %>">
          <footer class="flex justify-between items-center mb-2">
            <div class="flex items-center">
              <p class="inline-flex items-center mr-3 text-sm <%= current_user == comment.user ? 'text-orange-500' : 'text-green-700' %>  font-semibold">
                <% if current_user == comment.user %>
                  <span>You</span>
                <% else %>
                  <span><%= comment.user.full_name %></span>
                <% end %>
              </p>
              <p class="text-xs text-gray-600 dark:text-gray-400">
                <time datetime="<%= comment.created_at.to_fs(:db) %>" title="<%= comment.created_at.strftime('%B %d, %Y') %>"><%= time_ago_in_words(comment.created_at) %> ago</time>
              </p>
              <% if current_user == comment.user %>
                <%= button_to 'Delete', comment_path(comment), method: :delete, class: 'ml-4 text-red-600 text-xs' %>
              <% end %>
            </div>
          </footer>
          <p class="text-gray-500 dark:text-gray-400"><%= comment.message %></p>
        </article>
      <% end %>
    </div>
  </section>
</turbo-frame>
