<%= render_grid do %>
  <%= f.text_field :country_of_origin %>
  <%= f.text_field :country_of_application %>
  <%= f.text_field :native_language %>
  <%= f.text_field :linkedin_url %>
  <%= f.text_field :pronouns %>
  <%= f.select :marital_status, ApplicantDetail.marital_statuses.sort.map { |key, value| [key.humanize, key] }, prompt: true %>
  <%= f.text_area :tell_us_about_yourself %>
  <%= f.text_area :current_address %>

  <%= f.file_field :language_test_result_file, label: 'Please attach the results of the language test from an approved agency if you have taken one.' %>
<% end %>
