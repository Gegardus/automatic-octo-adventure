<%= render_page_container do %>
  <%= render_page_header heading: 'Applicant work experience' do %>
    <div class="flex">
      <%= link_to 'Edit', edit_inquiry_steps_applicant_work_experience_path(@applicant_work_experience), class: 'btn-secondary mr-2' %>

      <%= button_to 'Delete', inquiry_steps_applicant_work_experience_path(@applicant_work_experience), method: :delete, class: 'btn-danger' %>
    </div>
  <% end %>

  <%= render_details_list list: @applicant_work_experience.attributes.except('id', 'created_at', 'updated_at', 'user_id').map {|key, _| [key.humanize, @applicant_work_experience.send(key)]} %>
<% end %>
