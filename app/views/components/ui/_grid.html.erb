<% case columns %>
<% when :two %>
  <div class="<%= "grid grid-cols-1 gap-2 md:grid-cols-2 lg:gap-x-8 gap-y-0 #{classes}" %>">
    <%= yield %>
  </div>
<% when :three %>
  <div class="<%= "grid grid-cols-1 gap-2 md:grid-cols-3 lg:gap-x-8 gap-y-0 #{classes}" %>">
    <%= yield %>
  </div>
<% when :four %>
  <div class="<%= "grid grid-cols-1 gap-2 md:grid-cols-4 lg:gap-x-8 gap-y-0 #{classes}" %>">
    <%= yield %>
  </div>
<% end %>
