<%= tag.div class: "flex flex-col assessment-card justify-between box-border max-w-md p-4 border border-gray-300 rounded-md overflow-hidden h-full #{opacity ? 'opacity-30' : ''} #{active ? 'black-border' : ''}" do %>
  <%= tag.div class: "p-3 mb-4" do %>
    <%= tag.div class: "font-bold mb-6 flex items-center" do %>
      <%= tag.span class: "flex justify-center items-center w-9 h-9 bg-yellow-300 text-yellow-800 rounded-full text-xs font-bold mr-2" do %>
        <%= render_svg icon %>
      <% end %>
      <%= title %>
    <% end %>
    <%= tag.p class: "text-gray-700 text-base text-sm" do %>
      <%= description %>
    <% end %>
  <% end %>
  <%= tag.div do %>
    <% badges.each do |item| %>
      <%= tag.span item, class: "inline-block bg-gray-100 rounded-md p-3 text-xs font-semibold text-gray-700 mr-2 mb-2" %>
    <% end %>
  <% end %>
<% end %>
