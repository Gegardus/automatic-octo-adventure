<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inquiry awaiting approval</title>
  </head>
  <body>
    <div style="font-family: Arial, sans-serif;">
