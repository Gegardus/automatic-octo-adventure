    },
    {
      title: "5. Marketing and Sales Strategies",
      content: render_unordered_list(items: [
        content_tag(:strong, "Marketing Strategy:") + " Social media campaigns and influencer partnerships.",
        content_tag(:strong, "Sales Model:") + " Direct-to-consumer via platform.",
        content_tag(:strong, "Sales Tactics:") + " Flash sales and loyalty programs.",
