      content: render_unordered_list(items: [
        content_tag(:strong, "Description:") + " Platform selling electronics, apparel, home goods.",
        content_tag(:strong, "Unique Selling Points:") + " 2-hour delivery in major cities.",
        content_tag(:strong, "Pricing Strategy:") + " Competitive pricing with membership discounts.",
