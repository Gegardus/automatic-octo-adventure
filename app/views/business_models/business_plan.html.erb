        content_tag(:strong, "Sales Activities:") + " Onboarding top local brands."
      ])
    },
    {
      title: "6. Management and Organization",
      content: render_unordered_list(items: [
        content_tag(:strong, "Management Overview:") + " CEO with 10 years in e-commerce.",
        content_tag(:strong, "Organizational Structure:") + " CEO, CTO, COO, Sales, Marketing, Support.",
