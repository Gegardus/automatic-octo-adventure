        content_tag(:strong, "Pricing Strategy:") + " How you'll price your product/service",
        content_tag(:strong, "Lifecycle:") + " Stages of your product's existence.",
        content_tag(:strong, "R&D:") + " Efforts to improve or innovate."
      ])
    },
    {
