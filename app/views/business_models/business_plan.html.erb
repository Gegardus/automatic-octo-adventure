      ])
    },
    {
      title: "7. Operational Plan",
      content: render_unordered_list(items: [
        content_tag(:strong, "Supply Chain (if applicable):") + " Partnering with local logistics companies.",
        content_tag(:strong, "Production Workflow:") + " Continuous software development.",
        content_tag(:strong, "Facilities:") + " Main office in Toronto, server farms in Ontario.",
        content_tag(:strong, "Equipment/Technology:") + " Web servers, user data analytics tools.",
