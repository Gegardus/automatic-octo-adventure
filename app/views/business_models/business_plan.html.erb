      ])
    }
  ] %>

  <%= render_accordion(how_to_register_a_business_plan_sample_items) %>

  <%= render_paragraph content: 'This sample business plan provides a brief overview of how to structure your business plan using the provided template. Customize the template to fit your specific business needs and ensure that your detailed version includes the logic behind your decisions.' %>

  <%= render_title title: "Your Business Plan", size: "xl" %>

  <%= form_with model: @business_model, url: business_model_path(section: 'business_plan'), method: :patch, class: 'pl-7 mt-6' do |f| %>

    <%= render_title title: 'Executive Summary', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :business_name_and_location, label: 'Business Name and Location:', required: true  %>
      <%= f.text_field :mission_and_vision_statement, label: 'Mission and Vision Statements:', required: true  %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :products_or_service_overview, label: 'Product or Service Overview:', required: true  %>
      <%= f.text_field :objectives_summary, label: 'Summary of Objectives:', required: true  %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :market_brief_overview, label: 'Brief Market Overview:Nature of the Business:', required: true  %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Business Description', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :business_nature, label: 'Nature of the Business:', required: true %>
      <%= f.text_field :legal_structure, label: 'Legal Structure:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :business_history, label: 'Business History:', required: true %>
      <%= f.text_field :industry_background, label: 'Industry Background:', required: true %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Products or Services', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :products_or_services_description, label: 'Description:', required: true  %>
      <%= f.text_field :unique_selling_point, label: 'Unique Selling Points:', required: true  %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :pricing_strategy, label: 'Pricing Strategy:', required: true  %>
      <%= f.text_field :lifecycle, label: 'Lifecycle:', required: true  %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :research_and_development, label: 'R&D:', required: true  %>
    <% end %>
  
    <%= custom_hr_tag %>
    <%= render_title title: 'Market Analysis', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :target_market, label: 'Target Market:', required: true %>
      <%= f.text_field :market_size, label: 'Market Size:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :market_trends, label: 'Market Trends:', required: true%>
      <%= f.text_field :market_share, label: 'Market Share:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :customer_preference, label: 'Customer Preferences:', required: true %>
      <%= f.text_field :competitor_analysis, label: 'Competitor Analysis:', required: true %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Marketing and Sales Strategies', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :marketing_strategy, label: 'Marketing Strategy:', required: true %>
      <%= f.text_field :sales_model, label: 'Sales Model:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :sales_tactics, label: 'Sales Tactics:', required: true %>
      <%= f.text_field :sales_structure, label: 'Sales Structure:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :sales_activities, label: 'Sales Activities:', required: true %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Management and Organization', size: "base" %>
  
    <%= render_grid do %>
      <%= f.text_field :management_overview, label: 'Management Overview:', required: true %>
      <%= f.text_field :organizational_structure, label: 'Organizational Structure:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :responsibilities, label: 'Roles/Responsibilities:', required: true %>
      <%= f.text_field :ownership, label: 'Ownership:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :advisory, label: 'Board/Advisory:', required: true %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Operational Plan', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :supply_chain, label: 'Supply Chain:', required: true %>
      <%= f.text_field :production_workflow, label: 'Production Workflow:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :facilities, label: 'Facilities:', required: true %>
      <%= f.text_field :technology, label: 'Equipment/Technology:', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_field :quality_control, label: 'Quality Control:', required: true %>
    <% end %>

    <%= custom_hr_tag %>
    <%= render_title title: 'Financial Plan', size: "base" %>

    <%= render_grid do %>
      <%= f.text_field :start_up_capital, label: 'Start-up Capital:', required: true %>
      <%= f.text_field :budgets, label: 'Budgets:', required: true %>
    <% end %>

    <%= render_title title: "Additional Questions", size: "xl" %>

    <%= render_grid do %>
      <%= f.text_area :revenue_generation_timeline, label: 'When do you foresee your product/service becoming revenue-generating? (i.e. 18 months)', required: true %>
      <%= f.text_area :startup_fees, label: 'Will you have to pay any monthly/semi-annual/annual fees for your start-up? If so, what are they?', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_area :marketing_approach, label: "What's your approach to marketing and the channels you'll utilize to reach clients?", required: true %>
      <%= f.text_area :hiring_strategy, label: 'What is your hiring strategy? Is development going to be done in-house or outsourced?', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_area :marketing_contractors, label: 'Do you intend to employ staff or use contractors for your marketing activities?', required: true %>
      <%= f.text_area :hiring_forecast, label: 'Can you share a 5-year hiring forecast based on your current projections?', required: true %>

    <% end %>
    <%= render_grid do %>
      <%= f.text_area :pricing_structure, label: 'How have you structured your pricing and revenue sources? What are they?', required: true %>
      <%= f.text_area :sales_anticipation, label: 'When do you anticipate your company to start making sales?', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_area :target_audience, label: 'Who are your primary target audience and clients? How do you intend to attract them?', required: true %>
      <%= f.text_area :ip_protection, label: 'Do you need to protect any Intellectual Property? If yes, how & when do you plan to get it done?', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_area :break_even_point, label: 'At what point do you predict the company will reach its break-even point?', required: true %>
      <%= f.text_area :ownership_structure, label: 'How is ownership divided, and how much capital has each applicant invested?', required: true %>
    <% end %>
    <%= render_grid do %>
      <%= f.text_area :milestone_timeline, label: 'Share a timeline for your key milestone. (i.e. When will the solution or app be ready?)', required: true %>
      <%= f.text_area :management_compensation, label: 'For the management team, will compensation be through dividends or set salaries?', required: true %>
    <% end %>
    <%= f.submit 'Save' %>
  <% end %>
<% end %>