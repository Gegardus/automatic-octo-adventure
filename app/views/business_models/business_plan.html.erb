      content: render_unordered_list(items: [
        content_tag(:strong, "Target Market:") + " Who you're selling to.",
        content_tag(:strong, "Market Size:") + " The total potential customers.",
        content_tag(:strong, "Market Trends:") + " Current patterns in your market.",
        content_tag(:strong, "Market Share:") + " Your piece of the pie.",
        content_tag(:strong, "Customer Preferences:") + " What your customers like and dislike.",
        content_tag(:strong, "Competitor Analysis:") + " A look at your main competitors."
      ])
    },
    {
      title: "5. Marketing and Sales Strategies",
      content: render_unordered_list(items: [
        content_tag(:strong, "Marketing Strategy:") + " How you'll promote your business.",
        content_tag(:strong, "Sales Model:") + " How you'll get your product to customers.",
        content_tag(:strong, "Sales Tactics:") + " Techniques to boost sales.",
        content_tag(:strong, "Sales Structure:") + " Organization of your sales team.",
        content_tag(:strong, "Sales Activities:") + " Day-to-day sales operations."
      ])
    },
    {
      title: "6. Management and Organization",
      content: render_unordered_list(items: [
        content_tag(:strong, "Management Overview:") + " Key leadership roles.",
        content_tag(:strong, "Organizational Structure:") + " Company hierarchy.",
        content_tag(:strong, "Roles/Responsibilities:") + " Duties for each position.",
        content_tag(:strong, "Ownership:") + " Who holds stakes in the business.",
        content_tag(:strong, "Board/Advisory:") + " External advisors or directors."
      ])
    },
    {
      title: "7. Operational Plan",
      content: render_unordered_list(items: [
        content_tag(:strong, "Supply Chain (if applicable):") + " How you get resources for your product/service.",
        content_tag(:strong, "Production Workflow:") + " Steps to produce your offering.",
        content_tag(:strong, "Facilities:") + " Physical locations of operations.",
        content_tag(:strong, "Equipment/Technology:") + " Tools vital to your business.",
        content_tag(:strong, "Quality Control:") + " Ensuring the best product/service."
      ])
    },
    {
      title: "8. Financial Plan",
      content: render_unordered_list(items: [
        content_tag(:strong, "Start-up Capital:") + " Initial funds needed.",
        content_tag(:strong, "Budgets:") + " Expected incomes and expenses."
      ])
    }
  ] %>  

  <%= render_accordion(how_to_register_a_business_plan_template_items) %>

  <%= render_paragraph content: 'Use this template to fill in your answers for each section. Customize the template to fit your specific business needs.' %>
  <%= render_title title: "Sample Business Plan", size: "xl" %>
  <%= render_paragraph content: 'To help explain how to build your business plan, we have created a short, sample business plan using the previously shared template for an e-commerce platform looking to launch in Canada.' %>
  <%= render_paragraph content: '*Note: this is a summarized version of the business plan and does not contain the logic behind decisions, which will be expected from a detailed version of a business plan that you will need to develop for your business.' %>
  
  <% how_to_register_a_business_plan_sample_items = [
    {
      title: "1. Executive Summary",
      content: render_unordered_list(items: [
        content_tag(:strong, "Business Name and Location:") + " ShopHaven, based in Toronto.",
        content_tag(:strong, "Mission and Vision Statements:") + " Revolutionizing online shopping for Canadians. Aiming to be Canada's top e-commerce platform by 2030.",
